cat > "$BACKEND/index.js" <<'NODE'
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const cors = require('cors');
const fs = require('fs-extra');
const path = require('path');

const app = express();
const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });

app.use(cors());
app.use(express.json());

const DATA_FILE = path.join(__dirname, 'data.json');

async function readData() {
  try {
    return await fs.readJson(DATA_FILE);
  } catch (e) {
    return { requests: [], messages: [] };
  }
}
async function writeData(data) {
  await fs.writeJson(DATA_FILE, data, { spaces: 2 });
}

// REST: obtener solicitudes
app.get('/api/requests', async (req, res) => {
  const data = await readData();
  res.json(data.requests || []);
});

// REST: crear solicitud (puede venir del frontend)
app.post('/api/requests', async (req, res) => {
  const { type, note, from } = req.body;
  const data = await readData();
  const newReq = { id: 'req-' + Date.now(), type, note: note || '', from: from || 'unknown', time: new Date().toISOString(), status: 'new' };
  data.requests.unshift(newReq);
  await writeData(data);
  // notificar via socket
  io.emit('request:new', newReq);
  res.status(201).json(newReq);
});

// REST: marcar como atendida
app.post('/api/requests/:id/ack', async (req, res) => {
  const id = req.params.id;
  const data = await readData();
  const idx = data.requests.findIndex(r => r.id === id);
  if (idx === -1) return res.status(404).json({ error: 'not found' });
  data.requests[idx].status = 'handled';
  await writeData(data);
  io.emit('request:updated', data.requests[idx]);
  res.json(data.requests[idx]);
});

// Socket.IO — chat y sincronización
io.on('connection', (socket) => {
  console.log('socket connected', socket.id);

  // cliente pide historial
  socket.on('messages:get', async () => {
    const data = await readData();
    socket.emit('messages:list', data.messages || []);
  });

  // nuevo mensaje
  socket.on('message:new', async (msg) => {
    const data = await readData();
    const stored = { id: 'msg-' + Date.now(), ...msg, time: new Date().toISOString() };
    data.messages = data.messages || [];
    data.messages.push(stored);
    await writeData(data);
    // emitir a todos (en prototipo usamos broadcast global)
    io.emit('message:received', stored);
  });

  socket.on('disconnect', () => {
    console.log('socket disconnected', socket.id);
  });
});

const PORT = process.env.PORT || 4000;
server.listen(PORT, () => console.log(`Veremos backend listening on ${PORT}`));
NODE

