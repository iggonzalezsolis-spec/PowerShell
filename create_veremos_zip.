cat > "$COMP/RequestPanel.jsx" <<'JSX'
import React from 'react';

export default function RequestPanel({ requests = [], onAck }) {
  return (
    <div>
      <h3>Panel de solicitudes</h3>
      {requests.length === 0 && <p>No hay solicitudes.</p>}
      {requests.map(r => (
        <div key={r.id} className="req-item">
          <div><strong>{r.type}</strong></div>
          {r.note && <div>{r.note}</div>}
          <div>{new Date(r.time).toLocaleString()}</div>
          <div>Status: {r.status}</div>
          {r.status === 'new' && <button onClick={() => onAck(r.id)}>Marcar atendido</button>}
        </div>
      ))}
    </div>
  );
}
