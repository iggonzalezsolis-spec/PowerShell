import React, { useEffect, useState } from 'react';
import io from 'socket.io-client';
import ChatWindow from './components/ChatWindow';
import QuickRequests from './components/QuickRequests';
import RequestPanel from './components/RequestPanel';

const BACKEND = import.meta.env.VITE_BACKEND_URL || 'http://localhost:4000';
const socket = io(BACKEND);

const passengerId = 'pax-001';
const auxId = 'aux-001';

export default function App() {
  const [role, setRole] = useState('passenger');
  const [requests, setRequests] = useState([]);
  const [messages, setMessages] = useState([]);

  useEffect(() => {
    // cargar solicitudes via REST
    fetch(`${BACKEND}/api/requests`).then(r => r.json()).then(setRequests).catch(() => {});

    // solicitar historial de mensajes
    socket.emit('messages:get');
    socket.on('messages:list', (list) => setMessages(list));

    socket.on('message:received', (msg) => setMessages(prev => [...prev, msg]));
    socket.on('request:new', (req) => setRequests(prev => [req, ...prev]));
    socket.on('request:updated', (req) => setRequests(prev => prev.map(r => r.id === req.id ? req : r)));

    return () => {
      socket.off('messages:list');
      socket.off('message:received');
      socket.off('request:new');
      socket.off('request:updated');
    };
  }, []);

  const sendMessage = (from, to, text) => {
    const payload = { from, to, text };
    socket.emit('message:new', payload);
  };

  const sendQuickRequest = async (type, note) => {
    const body = { type, note, from: passengerId };
    await fetch(`${BACKEND}/api/requests`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    // backend emitirá la notificación
  };

  const acknowledge = async (id) => {
    await fetch(`${BACKEND}/api/requests/${id}/ack`, { method: 'POST' });
  };

  return (
    <div className="app-root">
      <header className="app-header">
        <h1>Veremos — Prototipo Full-Stack</h1>
        <div>
          <label>Ver como: </label>
          <select value={role} onChange={e => setRole(e.target.value)}>
            <option value="passenger">Pasajero</option>
            <option value="aux">Auxiliar</option>
          </select>
        </div>
      </header>

      <main className="app-main">
        {role === 'passenger' && (
          <div className="col-left">
            <QuickRequests onSend={sendQuickRequest} />
          </div>
        )}

        <div className="col-right">
          <ChatWindow me={role === 'passenger' ? passengerId : auxId} other={role === 'passenger' ? auxId : passengerId} messages={messages} onSend={(t) => sendMessage(role === 'passenger' ? passengerId : auxId, role === 'passenger' ? auxId : passengerId, t)} />
        </div>

        {role === 'aux' && (
          <aside className="side-panel">
            <RequestPanel requests={requests} onAck={acknowledge} />
          </aside>
        )}
      </main>
    </div>
  );
}
JSX

cat > "$COMP/ChatWindow.jsx" <<'JSX'
import React, { useEffect, useRef, useState } from 'react';

export default function ChatWindow({ me, other, messages, onSend }) {
  const [text, setText] = useState('');
  const boxRef = useRef(null);

  useEffect(() => {
    if (boxRef.current) boxRef.current.scrollTop = boxRef.current.scrollHeight;
  }, [messages.length]);

  const filtered = messages.filter(m => (m.from === me && m.to === other) || (m.from === other && m.to === me));

  return (
    <div className="chat-window">
      <div ref={boxRef} className="chat-list">
        {filtered.map(m => (
          <div key={m.id} className={`chat-msg ${m.from === me ? 'me' : 'them'}`}>
            <div className="msg-text">{m.text}</div>
            <div className="msg-time">{new Date(m.time).toLocaleTimeString()}</div>
          </div>
        ))}
      </div>
      <div className="chat-form">
        <input value={text} onChange={e => setText(e.target.value)} onKeyDown={e => { if (e.key === 'Enter' && text.trim()) { onSend(text.trim()); setText(''); } }} placeholder="Escribe un mensaje..." />
        <button onClick={() => { if (text.trim()) { onSend(text.trim()); setText(''); } }}>Enviar</button>
      </div>
    </div>
  );
}
JSX

